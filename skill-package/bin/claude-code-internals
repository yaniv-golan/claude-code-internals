#!/usr/bin/env bash
# claude-code-internals — run a claude-code-internals script without knowing where the plugin is
# staged. When installed as a plugin, this bin/ directory is on the Bash tool's
# PATH in every lane, including Cowork host-loop, where ${CLAUDE_SKILL_DIR} /
# ${CLAUDE_PLUGIN_ROOT} resolve to a *host* path the VM shell cannot open
# (references/45-plugin-bin-path-and-cloud-lane.md, L173). Resolving the scripts
# relative to this launcher's own location sidesteps that.
#
# Usage: claude-code-internals <script> [args...]      (script name without the .js/.sh extension)
#   claude-code-internals search "hooks system" --top=5    claude-code-internals state toggle-memory
#   claude-code-internals fetch-lesson 32                  claude-code-internals xref 32 25
#   claude-code-internals troubleshoot "hook not firing"   claude-code-internals check-version
set -euo pipefail

# Resolve this launcher's real directory, following a chain of symlinks so that a
# symlink-to-the-launcher (anywhere on PATH) still points at the staged scripts.
# BASH_SOURCE (not pwd) is the launcher's own path; readlink walks each link,
# resolving relative link targets against the link's own directory.
src="${BASH_SOURCE[0]:-$0}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd -P)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$dir/$src" ;; esac
done
here="$(cd -P "$(dirname "$src")" && pwd -P)"
scripts="$here/../skills/claude-code-internals/scripts"

if [ "$#" -eq 0 ]; then
  echo "usage: claude-code-internals <script> [args...]   (e.g. claude-code-internals search hooks --top=5)" >&2
  exit 2
fi
name="$1"; shift

if [ -f "$scripts/$name.js" ]; then
  exec node "$scripts/$name.js" "$@"
elif [ -f "$scripts/$name.sh" ]; then
  exec bash "$scripts/$name.sh" "$@"
else
  echo "claude-code-internals: no script named '$name' under $scripts" >&2
  exit 127
fi
